generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int            @id @default(autoincrement())
  email              String         @unique
  password           String
  name               String
  role               String         @default("STUDENT")
  institution_id     Int?
  displayId          String?        @unique
  subject            String?
  created_at         DateTime       @default(now())
  createdByStudent   Boolean        @default(false)
  hasCredentials     Boolean        @default(true)
  tempPassword       String?
  studentAttendances Attendance[]
  studentBatches     BatchStudent[]
  trainerBatches     BatchTrainer[]
  notifications      Notification[]
  trainerSessions    Session[]
  sessionJoins       SessionJoin[]  @relation("StudentSessionJoins")
  todos              Todo[]
  institution        User?          @relation("InstitutionToUsers", fields: [institution_id], references: [id])
  members            User[]         @relation("InstitutionToUsers")
}

model Batch {
  id             Int            @id @default(autoincrement())
  name           String
  institution_id Int
  displayId      String?        @unique
  created_at     DateTime       @default(now())
  students       BatchStudent[]
  trainers       BatchTrainer[]
  sessions       Session[]
}

model BatchTrainer {
  batch_id   Int
  trainer_id Int
  batch      Batch @relation(fields: [batch_id], references: [id])
  trainer    User  @relation(fields: [trainer_id], references: [id])

  @@id([batch_id, trainer_id])
}

model BatchStudent {
  batch_id   Int
  student_id Int
  batch      Batch @relation(fields: [batch_id], references: [id])
  student    User  @relation(fields: [student_id], references: [id])

  @@id([batch_id, student_id])
}

model Session {
  id           Int           @id @default(autoincrement())
  batch_id     Int
  trainer_id   Int
  title        String
  date         DateTime
  start_time   String
  end_time     String
  meeting_link String?
  created_at   DateTime      @default(now())
  attendance   Attendance[]
  batch        Batch         @relation(fields: [batch_id], references: [id])
  trainer      User          @relation(fields: [trainer_id], references: [id])
  sessionJoins SessionJoin[] @relation("SessionJoins")
}

model Attendance {
  id         Int      @id @default(autoincrement())
  session_id Int
  student_id Int
  status     String
  marked_at  DateTime @default(now())
  session    Session  @relation(fields: [session_id], references: [id])
  student    User     @relation(fields: [student_id], references: [id])

  @@unique([session_id, student_id])
}

model SessionJoin {
  id         Int      @id @default(autoincrement())
  session_id Int
  student_id Int
  joined_at  DateTime @default(now())
  marked     Boolean  @default(false)
  created_at DateTime @default(now())
  session    Session  @relation("SessionJoins", fields: [session_id], references: [id])
  student    User     @relation("StudentSessionJoins", fields: [student_id], references: [id])

  @@unique([session_id, student_id])
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  title      String
  message    String
  status     String   @default("UNREAD")
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
}

model Todo {
  id          Int       @id @default(autoincrement())
  user_id     Int
  title       String
  description String?
  completed   Boolean   @default(false)
  due_date    DateTime?
  auto_delete Boolean   @default(false)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  user        User      @relation(fields: [user_id], references: [id])
}
